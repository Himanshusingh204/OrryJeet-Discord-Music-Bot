# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_server_guild_id_here

# Bot Settings
PREFIX=!
BOT_OWNER_ID=your_discord_user_id

# Logging
LOG_LEVEL=info

# YouTube & Audio
FFMPEG_PATH=ffmpeg
YOUTUBE_DISABLED=false

# Database
DB_PATH=./data/bot.db

# Voice
AUTO_RECONNECT=true
VOICE_TIMEOUT=300000

# Feature Flags
ENABLE_SOUNDBOARD=true
ENABLE_CUSTOM_SOUNDS=true
MAX_CUSTOM_SOUNDS=100
MAX_SOUND_SIZE_MB=5
