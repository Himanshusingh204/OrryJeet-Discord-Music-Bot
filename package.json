{
  "name": "discord-music-soundboard-bot",
  "version": "1.0.0",
  "description": "Discord.js v14 music and soundboard bot using discord-player and play-dl.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "deploy-and-start": "npm run deploy && npm start"
  },
  "keywords": [
    "discord",
    "discord.js",
    "music",
    "soundboard"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "debug": "^4.4.3",
    "discord-player": "^6.7.1",
    "discord.js": "^14.16.3",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "youtube-dl-exec": "^3.1.19"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.12": true
  }
