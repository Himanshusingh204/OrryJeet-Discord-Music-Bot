{
  "name": "orryjeet-discord-music-bot",
  "version": "1.1.0",
  "description": "Enterprise Discord audio streaming engine and cloud soundboard with 48kHz Opus fidelity",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "nodemon src/bot.js",
    "deploy": "node src/deploy-commands.js",
    "check": "node --check src/bot.js src/deploy-commands.js src/commands/*.js src/events/*.js src/utils/*.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "discord",
    "music-bot",
    "soundboard",
    "opus",
    "audio-streaming",
    "discordjs-v14"
  ],
  "author": "OrryJeet Engineering Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Himanshusingh204/OrryJeet-Discord-Music-Bot.git"
  },
  "dependencies": {
    "@discordjs/voice": "^0.16.0",
    "axios": "^1.6.2",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "play-dl": "^1.9.7",
    "sqlite": "^5.0.1",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
